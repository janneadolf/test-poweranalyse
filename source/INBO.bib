
@misc{ingre_cocktail_2019,
	title = {A cocktail fallacy in research with composite variables: a commentary on job strain and effort–reward imbalance ({ERI}) theories with updated meta-analyses on health outcomes},
	rights = {https://creativecommons.org/licenses/by/4.0/legalcode},
	url = {https://osf.io/9hyxj},
	doi = {10.31234/osf.io/9hyxj},
	shorttitle = {A cocktail fallacy in research with composite variables},
	abstract = {Job strain and effort–reward imbalance are two widely used theories in occupational stress research. In this paper we show that a large body of research based on these theories needs to be reevaluated. We take a non-technical approach to show that the use of single parameter composite variable models to test the job strain and effort–reward imbalance theories is insufficient. Further, we describe how to use standard two or three parameter models to investigate associations proposed by these theories. We present a method for recalculating estimates from a particular composite variable model so they represent proper estimates from a three parameter interaction model, and apply that method on estimates from five large studies on health outcomes. We also present an updated meta-analysis on job strain and coronary heart disease ({CHD}) with over 400k subjects and \&gt;6.8k {CHD} cases using such recalculated estimates. The results show no support for the job strain theory, indicating instead that low job control alone is associated with an increased risk of {CHD}. We conclude that further research on the job strain and effort-reward imbalance theories using single parameter composite variable models is untenable and that a constructive avenue for occupational stress research is to better understand the association between low job control and adverse health outcomes.},
	author = {Ingre, Michael and Sorjonen, Kimmo and Nilsonne, Gustav},
	urldate = {2024-08-06},
	date = {2019-02-24},
}

@article{sternhagen_comparing_2024,
	title = {Comparing cost, effort, and performance of environmental {DNA} sampling and trapping for detecting an elusive freshwater turtle},
	volume = {6},
	issn = {2637-4943, 2637-4943},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/edn3.525},
	doi = {10.1002/edn3.525},
	abstract = {Abstract
            
              Environmental {DNA} ({eDNA}) analysis is an effective and non‐invasive technique for surveying and monitoring rare, threatened, or endangered ({RTE}) species. Compared to conventional capture‐based sampling, {eDNA} analysis may offer a more cost‐effective approach for surveying {RTE} species, yet few studies have compared their cost‐efficiency—a critical consideration for conservation planning. We compared the costs, effort, and relative performance of aquatic {eDNA} sampling and conventional trapping for detecting the Alligator Snapping Turtle,
              Macrochelys temminckii
              Troost, 1835, in southwest Louisiana, United States. Environmental {DNA} was sampled quarterly over 1 year (2018–2019) at 19 streams, including three streams where
              M. temminckii
              presence had been previously confirmed via conventional trapping efforts (2012–2013). Water samples from each stream were analyzed using quantitative polymerase chain reaction ({qPCR}) to assess
              M. temminckii
              {eDNA} presence/absence. Time and costs (i.e., labor, travel, wages, and supplies) per detection via {eDNA} analysis and trapping were calculated and compared. Environmental {DNA} analysis documented the presence of
              M. temminckii
              {DNA} at two of the three streams where individuals had previously been trapped and yielded detections ({qPCR} amplifications) at 16 additional streams not previously sampled, expanding
              M. temminckii
              's documented distribution at our study sites by 84\%. Environmental {DNA} analysis returned a detection rate (per site) 5.55 times higher than conventional trapping and was 18.7\% less expensive. Our results provide evidence that strategically deployed {eDNA} surveys may be an effective and cost‐efficient approach for detecting freshwater {RTE} species. With {eDNA} analysis, additional resources can be invested toward expanding survey coverage and increasing sampling frequency, allowing managers to more effectively target subsequent intensive monitoring efforts.},
	pages = {e525},
	number = {2},
	journaltitle = {Environmental {DNA}},
	shortjournal = {Environmental {DNA}},
	author = {Sternhagen, Elizabeth C. and Davis, Mark A. and Larson, Eric R. and Pearce, Sarah E. and Ecrement, Stephen M. and Katz, Aron D. and Sperry, Jinelle H.},
	urldate = {2024-08-06},
	date = {2024-03},
	langid = {english},
}

